# Student app (e-meyar student version). Names only - never commit real values.

# The NEW student Anthropic API key (not the teacher app's key).
ANTHROPIC_API_KEY=

# The NEW student Supabase project (Project Settings -> API).
# Anon key only: the server never uses a service-role key; RLS is the wall.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Public base URL of THIS environment, no trailing slash (for now the Railway
# domain). Used in confirmation and password-reset links. Supabase ->
# Authentication -> URL Configuration needs: Site URL = this value, and
# Redirect URLs = <SITE_URL>/login.html and <SITE_URL>/reset-password.html.
SITE_URL=

# Grades per student per day (resets at 00:00 Baku time). Unset = 10.
# Production: 25 (set 9 Oct 2026).
DAILY_GRADE_LIMIT=

# Practice sets per student per day (Baku day). Unset = 10.
PRACTICE_DAILY_LIMIT=

# The calibrated DİM grading prompt (withheld from this public snapshot; see
# README, "Withheld"). Grading stops with a clear error when it is missing.
GRADING_PROMPT=

# production on Railway; leave empty locally.
NODE_ENV=

# Local only (Railway sets its own).
PORT=3000
